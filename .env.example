LLM_PROVIDER=google
# Ambil gratis di: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=masukkan_api_key_google_anda_disini
GEMINI_MODEL=gemini-2.5-flash
# Dipakai otomatis bila kuota harian model utama habis
GEMINI_MODEL_CADANGAN=gemini-2.0-flash,gemini-flash-lite-latest
EMBEDDING_MODEL=models/gemini-embedding-001

# Ambil di: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

#Dokumen & penyimpanan index
PDF_PATH=data/Lora.pdf
INDEX_DIR=vectorstore

#Pengendali laju embedding
EMBED_BATCH=90
EMBED_JEDA=62

#Parameter RAG
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=8
MMR_K=6
FETCH_K=30
MAX_KONTEKS=14
TEMPERATURE=0.1
